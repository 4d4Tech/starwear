{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api-asset-proxy",
        "function": "assetProxy"
      },
      {
        "source": "/api-asset-proxy/**",
        "function": "assetProxy"
      },
      {
        "source": "/api-tripo-download",
        "function": "assetProxy"
      },
      {
        "source": "/api-tripo-download/**",
        "function": "assetProxy"
      },
      {
        "source": "/api-tripo/**",
        "function": "tripoProxy"
      },
      {
        "source": "/api-3daistudio/**",
        "function": "threeDAIProxy"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  }
}